    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@btf/application": "workspace:*",
    "@btf/domain": "workspace:*",
    "bullmq": "^5.28.1",
    "cockatiel": "^3.2.1",
    "drizzle-orm": "^0.36.4",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "postgres": "^3.4.5",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.2",
    "@testcontainers/redis": "^10.13.2",
    "@types/node": "^20.14.0",
    "drizzle-kit": "^0.28.1",
    "testcontainers": "^10.13.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
