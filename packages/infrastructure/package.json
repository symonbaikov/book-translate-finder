{
  "name": "@btf/infrastructure",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo",
