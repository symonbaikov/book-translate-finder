# Copy to apps/web/.env.local for local dev (docs/plan.md §1.5): Next.js only reads env files
# from its own app directory, not the monorepo root, so this can't just live in the root .env.

# Base URL apps/web calls for all API requests. Must be reachable from the browser, not just
# from the server (so `http://api:3001` from Docker's internal network will NOT work here).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional. Where this instance publishes ready-made custom-source templates — a Telegram channel,
# a wiki page, a gist. When set, the custom sources page shows a link to it and the first-run tour
# points the reader at it; when unset, neither exists. Left empty here deliberately: this
# repository links to no catalogue of sources (docs/adr/0009, docs/legal-policy.md §I-3), and an
# operator who fills this in is choosing, and answering for, what their readers are sent to.
# NEXT_PUBLIC_COMMUNITY_PRESETS_URL=https://t.me/your-channel
