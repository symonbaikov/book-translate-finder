# Copy this file to .env and fill in the values. Every process validates its config against a
# Zod schema at startup and refuses to boot on an invalid or missing value (docs/rules.md §3) —
# there is no way to silently run with a bad config.
#
# Local dev via `docker/docker-compose.dev.yml` (Postgres + Redis on the host) already matches
# the DATABASE_URL/REDIS_URL defaults below. For self-hosting via the root docker-compose.yml
# (Phase 1.6), see docs/architecture.md §9.2 — that compose computes DATABASE_URL/REDIS_URL
# itself from POSTGRES_PASSWORD below (pointing at the `postgres`/`redis` services inside its own
# docker network), so you do not need to edit the two lines below for self-hosting specifically.

# --- Self-host production compose only (docker-compose.yml, Фаза 1.6) --------------------------
#
# Ignored by `pnpm dev` / docker/docker-compose.dev.yml — only the root docker-compose.yml reads
# these.

# Generate a real one with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-before-self-hosting

# Pins which published image tag `docker compose pull` fetches (docs/architecture.md §9.1 — never
# `:latest` in a real deployment, an unpinned pull can arrive with an incompatible migration).
# Left at `latest` here only so the file is usable as-is; production installs should pin a real
# semantic version once a release exists.
IMAGE_TAG=latest

# Skip the Internet Archive backfill job on startup. The job adds download links from
# Internet Archive for all existing editions that don't have them yet. It's idempotent and safe
# to run multiple times, but you can set this to 'true' to skip it if you prefer to run it
# manually later with: pnpm tsx scripts/backfill-ia-links.ts
SKIP_BACKFILL=false

# Only read by the optional `tls` profile (`docker compose --profile tls up -d`, docker/Caddyfile)
# — a real public domain pointing at this machine, so Caddy can obtain a Let's Encrypt certificate.
# Leave unset if you're not using that profile.
DOMAIN=

# --- Shared (apps/api, apps/worker) -----------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://btf:btf_dev_password@localhost:5432/btf
REDIS_URL=redis://localhost:6379

# Sent as part of the User-Agent header on every request to an external source — required by
# etiquette for public APIs like Open Library (docs/legal-policy.md §4). Point it at your repo,
# a contact page, or an email.
CONTACT_URL=https://github.com/<you>/golden-library

# Optional — leave unset to run with lower rate limits (normal for self-hosting, see
# docs/architecture.md §9.2). Read by apps/worker (the process that actually calls providers);
# apps/api only needs it declared here because both processes share this one .env file.
GOOGLE_BOOKS_API_KEY=
WORLDCAT_API_KEY=

# --- apps/api ----------------------------------------------------------------------------------

API_PORT=3001

# The externally reachable URL of this API instance — used for CORS in production and for
# building absolute links. In local dev this can stay as-is.
PUBLIC_URL=http://localhost:3001

# Authorizes POST /api/sync/:source (docs/architecture.md §4). Generate a real secret with:
#   openssl rand -hex 32
ADMIN_TOKEN=dev-only-admin-token-change-me

# Global per-IP request budget across every /api route (docs/plan.md §1.4). Defaults are set
# above one browsing session's worst case (search polling + covers + edition links + prices);
# raise RATE_LIMIT_MAX or widen RATE_LIMIT_WINDOW_MS further for heavier traffic.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# --- apps/worker -------------------------------------------------------------------------------

WORKER_CONCURRENCY=5

# Cron RefreshStaleWorks (docs/architecture.md §5): re-check a work at least this often, capped
# at this many works per run so a large instance doesn't burst-enqueue thousands of jobs at once.
#
# One stale work costs one job per registered source — discovery *and* enrichment, currently 20 —
# so the batch size below is the real lever on nightly load. Enrichment is in that count on
# purpose: it is the only way a source added today ever reaches a book discovered yesterday.
# Turning this down does not lose anything, it just means the pass takes more nights to walk the
# whole catalog.
REFRESH_STALE_AFTER_DAYS=7
REFRESH_BATCH_SIZE=50

# --- apps/web ------------------------------------------------------------------------------------
#
# For local dev, this section is informational only — Next.js reads env files from apps/web's own
# directory, not the repo root. Copy apps/web/.env.example to apps/web/.env.local instead
# (see CLAUDE.md "Запуск").
#
# For the self-host compose: NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD
# time, not read at container startup — a value here can't retroactively fix an already-built
# image. That is why the self-host compose builds apps/web's image locally from source using this
# value as a build arg, instead of pulling a pre-built one like api/worker/migrate (the one
# deliberate exception to "self-host pulls, never builds", docs/architecture.md §9.1).
#
# apps/web also makes server-side (SSR) fetches for the work-card page — those run *inside the
# web container*, where this browser-facing value doesn't resolve to the api container. The
# self-host compose sets a second, non-public env var for that (`INTERNAL_API_URL:
# http://api:3001`, directly in docker-compose.yml, not here) — found live, docs/plan.md §1.6.
# You don't need to set anything for this yourself; it's already wired into docker-compose.yml.

# Base URL apps/web calls for all API requests. Must be reachable from the browser, not just
# from the server (so `http://api:3001` from Docker's internal network will NOT work here). For
# self-hosting behind a single reverse-proxied domain (the optional `tls` Caddy profile), this can
# just be that same public domain, since `/api/*` gets routed to the api service on the same origin.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Accounts (docs/plan.md Phase 4.5) -----------------------------------------------------
# All optional. With none of them set, an instance still has working accounts: email + password,
# no welcome mail, no Google button. That is the intended `docker compose up` experience.
#
# Google sign-in. Both or neither — half-configured renders a button that always fails, so the
# button is hidden unless both are present. Register the redirect URI in the Google console as
# <PUBLIC_URL>/api/auth/google/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Welcome email. Unset means no mail is sent and registration still succeeds.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Golden Library <noreply@example.com>
#
# Where the browser lives, for OAuth redirects back out of the API.
WEB_BASE_URL=http://localhost:3000

# --- Bookshops nearby (docs/adr/0007-plugin-architecture.md) -------------------------------
# Server-side bookshop lookup, `GET /api/stores/nearby`. Off by default, and the default is the
# privacy decision rather than a convenience: the web app already runs the same OpenStreetMap
# lookup in the reader's browser, so their coordinates never arrive here at all. Turning this on
# means accepting locations into this instance's logs and outbound requests — worth it only for a
# client that cannot do the lookup itself (a CLI, a future mobile app).
# ENABLE_SERVER_GEO_LOOKUP=false
